# Environment Variables Template
# NEVER commit real secrets to source control.

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Persistent Content Database (e.g., PostgreSQL / SQLite / Supabase / Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_intro_db

# Admin Authentication & Session Management
ADMIN_SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string
INITIAL_ADMIN_USERNAME=admin_placeholder
INITIAL_ADMIN_PASSWORD=change_me_on_first_login_secure_password_placeholder

# Anthropic Claude API (Server-side only, US$100 allocated budget)
# Default recommended model: claude-haiku-5-5 per Section 6
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-expose-in-browser
CLAUDE_MODEL=claude-haiku-5-5

# Runtime Avatar Provider API (Server-side adapter; evaluated in Milestone 3)
# Target provider: D-ID / HeyGen / Simli
AVATAR_PROVIDER=d-id
AVATAR_PROVIDER_API_KEY=provider_api_key_placeholder
